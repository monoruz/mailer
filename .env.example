# Copy to .env and fill in. Keep it chmod 600: it holds a bot token.
#   cp .env.example .env && chmod 600 .env
#
# Any key left out here falls back to the process environment.

# Required
RADAR_BOT_TOKEN=123456789:AA-replace-me
TELEGRAM_CHAT_ID=987654321

# Recipient domains to accept. Empty means every mail is dropped.
VALID_DOMAINS=example.com,finestel.com

# Optional
SMTP_PORT=25
SEND_ATTACHMENTS=1
MAX_ATTACHMENT_BYTES=20971520
DEBUG=0
